# Copia este archivo como .env y completa los valores. El archivo .env no se sube a git.

# Embeddings (OpenAI)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Generación (se define en la semana 2)
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# Chunking
CHUNK_TOKENS=512
CHUNK_OVERLAP=64

# Recuperación
TOP_K_RETRIEVE=30
TOP_K_FINAL=5
RRF_K=60
USE_RERANKER=false
REFUSAL_THRESHOLD=
