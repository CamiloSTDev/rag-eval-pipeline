# Copia este archivo como .env y completa los valores. El archivo .env no se sube a git.

# Embeddings (OpenAI)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

# Generación: openai (usa OPENAI_API_KEY) o deepseek (usa DEEPSEEK_API_KEY).
# LLM_MODEL es el nombre exacto del modelo según la documentación del proveedor.
# LLM_BASE_URL solo hace falta para otro servidor compatible con la API de OpenAI.
# LLM_TEMPERATURE: 0 para respuestas reproducibles; "default" para no enviarla, necesario en los
# modelos de razonamiento (gpt-5 en adelante, o3), que solo aceptan su propio valor.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0
DEEPSEEK_API_KEY=

# Juez de la evaluación (fidelidad y relevancia): debe ser un modelo distinto del generador.
# JUDGE_MODEL vacío = rag eval corre sin juez.
JUDGE_PROVIDER=deepseek
JUDGE_MODEL=
JUDGE_TEMPERATURE=0

# API: clave para POST /ingest (header X-Admin-Key). Vacía = ingesta por API desactivada.
ADMIN_API_KEY=

# Corpus e índice (rutas relativas a la raíz del proyecto)
CORPUS_PATH=data/raw
CORPUS_EXCLUDE=["_llm-test.md", "translation-banner.md"]
INDEX_PATH=data/index
GOLDEN_PATH=data/eval/golden.jsonl
RESULTS_PATH=results

# Chunking
CHUNK_TOKENS=512
CHUNK_OVERLAP=64

# Recuperación. Estos valores son la configuración elegida con los experimentos (ver el README);
# el baseline E0 usa EMBEDDING_MODEL=text-embedding-3-small, USE_BM25=false,
# USE_RERANKER=false y REFUSAL_THRESHOLD=0.
TOP_K_RETRIEVE=30
TOP_K_FINAL=5
USE_BM25=true
RRF_K=60
# Reranker con un LLM: reordena los primeros RERANK_CANDIDATES candidatos antes de generar
USE_RERANKER=true
RERANKER_PROVIDER=openai
RERANKER_MODEL=gpt-4.1-mini
RERANKER_TEMPERATURE=0
RERANK_CANDIDATES=20
# Similitud vectorial mínima para llamar al modelo; 0 = sin umbral. Depende del modelo de
# embeddings: 0.45 está calibrado para text-embedding-3-large.
REFUSAL_THRESHOLD=0.45
