# Copia este archivo como .env y completa los valores. El archivo .env no se sube a git.

# Embeddings (OpenAI)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Generación: openai (usa OPENAI_API_KEY) o deepseek (usa DEEPSEEK_API_KEY).
# LLM_MODEL es el nombre exacto del modelo según la documentación del proveedor.
# LLM_BASE_URL solo hace falta para otro servidor compatible con la API de OpenAI.
LLM_PROVIDER=openai
LLM_MODEL=
LLM_BASE_URL=
DEEPSEEK_API_KEY=

# Corpus e índice (rutas relativas a la raíz del proyecto)
CORPUS_PATH=data/raw
CORPUS_EXCLUDE=["_llm-test.md", "translation-banner.md"]
INDEX_PATH=data/index
GOLDEN_PATH=data/eval/golden.jsonl
RESULTS_PATH=results

# Chunking
CHUNK_TOKENS=512
CHUNK_OVERLAP=64

# Recuperación
TOP_K_RETRIEVE=30
TOP_K_FINAL=5
RRF_K=60
USE_RERANKER=false
REFUSAL_THRESHOLD=
